# Copia este archivo como .env y completa los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

NODE_ENV=development
PORT=3000

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=argusnexus
# true si el proveedor de MySQL en la nube exige conexión cifrada
DB_SSL=false

# --- Sesión ---
# Texto largo y aleatorio. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_HORAS=8

# --- Parámetros del SLA (horas) ---
SLA_HORAS_PLAZO=24
SLA_HORAS_UMBRAL_EXTENSION=2
SLA_HORAS_EXTENSION=2
SLA_HORAS_UMBRAL_CRITICO=2
# Cada cuántos segundos el servidor revisa los plazos vencidos (RF9)
SLA_SEGUNDOS_REVISION=60

# --- Cuentas de prueba (npm run seed) ---
SEED_ADMIN_CORREO=admin@argusnexus.test
SEED_ADMIN_CLAVE=
SEED_EQUIPO_CORREO=equipo@argusnexus.test
SEED_EQUIPO_CLAVE=
